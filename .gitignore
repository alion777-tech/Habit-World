# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase admin key (絶対公開禁止)
serviceAccountKey.json
service-account.json
firebase-adminsdk*.json

# Local logs, Firebase emulator state, and generated previews/test output
*.log
*.log.*
/build_log*.txt
.firebase/
/dist/
/output/

# Credentials and service-account private keys (at any directory depth)
credentials.json
credentials-*.json
credentials.*.json
*serviceAccount*.json
*service-account*.json
*service_account*.json
*firebase-adminsdk*.json
*.key
*.p12
*.pfx
